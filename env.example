# Copy to .env at the repo root and fill in. .env is gitignored -- never
# commit real values. Used by scripts/tf.py (maps these to Terraform
# variables), scripts/deploy_site.sh, and scripts/sync_gallery.py.

# Globally-unique S3 bucket for the site + photos.
S3_BUCKET=your-bucket-name

# Custom domain the gallery is served on.
DOMAIN_NAME=gallery.example.com

# AWS CLI profile to deploy with.
AWS_PROFILE=default

# Prefix for the Cognito Hosted UI domain -- must be globally unique.
COGNITO_DOMAIN_PREFIX=your-gallery

# Region for S3 / Cognito / Lambda. Must support Lambda function URLs --
# ap-southeast-6 does not. The default is in infrastructure/variables.tf.
AWS_REGION=ap-southeast-2
